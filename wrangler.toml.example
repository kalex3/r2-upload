name = "r2up"
main = "src/index.ts"
compatibility_date = "2026-10-18"

# Keep this worker off *.workers.dev. The only public door should be the
# secret path on the domain that already serves the bucket.
workers_dev = false
preview_urls = false

# That domain serves the R2 bucket on every path. A route claims a path for
# this worker instead. Use the exact path, with no "*":
# a wildcard would take those URLs away from the bucket.
# Do not attach a Worker Custom Domain on this hostname either. Custom
# domains take every path, and the bucket would stop being served.
#
# Uncomment and set both the route and UPLOAD_PATH to the same path.
#
# [[routes]]
# pattern = "files.example.com/paste-a-long-random-path"
# zone_name = "example.com"

# Optional, if you want a trailing slash to open the page too.
# [[routes]]
# pattern = "files.example.com/paste-a-long-random-path/"
# zone_name = "example.com"

[[r2_buckets]]
binding = "BUCKET"
bucket_name = "your-bucket"

# Which worker owns which file. Create the namespace once:
#   wrangler kv namespace create FILES
[[kv_namespaces]]
binding = "FILES"
id = "paste-the-namespace-id"

[vars]
# This path is the access check. Share https://<domain><UPLOAD_PATH> only
# with people who may upload. Generate one with: openssl rand -hex 24
UPLOAD_PATH = "/paste-a-long-random-path"
# Optional. When set, the page asks for this token and curl must send
# Authorization: Bearer. Store it as a secret, not in this file:
#   openssl rand -hex 32 | npx wrangler secret put UPLOAD_TOKEN
# For npm run dev, put UPLOAD_TOKEN=... in .dev.vars instead.
# Unique per worker. The file list on that worker only includes objects
# this name created. Lowercase letters, numbers, and hyphens.
WORKER_NAME = "admin"
# Set to "true", deploy, open this worker's page, and use Claim existing files.
# That moves any old .uploader records into KV, deletes them, and assigns every
# file in the bucket which no worker owns yet, except CLAIM_EXCLUDE. Deploy
# again with "false" when it is done. Claimed files count toward this worker's quota.
CLAIM_UNOWNED = "false"
# Directories claim leaves unowned. Each entry is a key prefix.
# CLAIM_EXCLUDE = "assets/,docs/"
# Per-worker cap in bytes. 1000000000 is 1 GB.
QUOTA_BYTES = "10000000000"
# Cap for everything in this bucket, in bytes. 10000000000 is 10 GB.
ACCOUNT_QUOTA_BYTES = "10000000000"
# Heading and the paragraph under it. Leave PAGE_DESCRIPTION empty to hide it.
PAGE_TITLE = "R2 Uploader"
PAGE_DESCRIPTION = ""
# Characters in a random object name. The alphabet is 0-9, A-Z, and a-z.
RANDOM_NAME_LENGTH = "8"
# Default for the Keep original filenames checkbox, and for a curl upload
# that omits x-keep-original. "true" uses x-key. "false" uses a random name.
KEEP_ORIGINAL_NAMES = "true"
# Default for the Keep extension checkbox, and for a random curl name that
# omits x-keep-extension. "true" adds an extension. "false" leaves it off.
KEEP_EXTENSION = "false"
# PAGE_DESCRIPTION = "Paste an image or choose a file, edit the name, then use its Upload button. If that name is already taken, choose another one. Your files are under My files. The zone upload limit applies (100 MB on Free and Pro)."
